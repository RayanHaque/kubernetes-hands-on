
pipeline {
    agent any

    stages {
        stage('Pre-check') {
            steps {
                dir('exercise-6-real-time-monitoring') {
                    echo 'Checking Exercise 6 project files'
                    sh 'pwd'
                    sh 'test -f delivery_metrics.py'
                    sh 'test -f prometheus.yml'
                    sh 'test -f alert_rules.yml'
                    sh 'test -f docker-compose.yml'
                }
            }
        }

        stage('Validate Python') {
            steps {
                dir('exercise-6-real-time-monitoring') {
                    sh 'python3 -m py_compile delivery_metrics.py'
                }
            }
        }

        stage('Validate Compose') {
            steps {
                dir('exercise-6-real-time-monitoring') {
                    sh 'docker compose config -q'
                }
            }
        }

        stage('Build Delivery Metrics Image') {
            steps {
                dir('exercise-6-real-time-monitoring') {
                    sh 'docker compose build delivery-metrics'
                }
            }
        }
    }

    post {
        success {
            echo 'Exercise 6 validation and image build completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
    }
}

